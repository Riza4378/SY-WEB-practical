<!DOCTYPE html>\par
<html>\par
<head>\par
    <title>Document Object Manipulation</title>\par
\par
    <style>\par
        body \{\par
            background: #dcd6f7;\par
            font-family: Arial;\par
        \}\par
\par
        #box \{\par
            padding: 20px;\par
            text-align: center;\par
            background: white;\par
            border-radius: 15px;\par
        \}\par
\par
        #title \{\par
            color: purple;\par
        \}\par
\par
        #message \{\par
            padding: 10px;\par
            background: #eee;\par
            border-radius: 8px;\par
        \}\par
\par
        #image \{\par
            border-radius: 10px;\par
        \}\par
\par
        button \{\par
            margin: 5px;\par
            padding: 8px 15px;\par
            border: none;\par
            border-radius: 15px;\par
            background: purple;\par
            color: white;\par
        \}\par
    </style>\par
</head>\par
\par
<body>\par
\par
    <div id="box">\par
\par
        <h1 id="title">DOM Manipulation</h1>\par
\par
        <p id="message">This is my DOM.</p>\par
\par
        <img id="image"\par
             src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRsq_CwZBFZlDz9va9-MpXqDju1fMfJ043Iud2udU6Vaw&s=10"\par
             width="300">\par
\par
        <br><br>\par
\par
        <a id="link" href="https://www.google.com">\par
            Google\par
        </a>\par
\par
        <br><br>\par
\par
        <button onclick="content()">Change Content</button>\par
\par
        <button onclick="styleChange()">Change Style</button>\par
\par
        <button onclick="imageChange()">Change Image</button>\par
\par
        <button onclick="linkChange()">Change Link</button>\par
\par
       <button onclick="attributeChange()">change Attribute</button>\par
\par
\par
       \par
    </div>\par
\par
    <script>\par
\par
        function content() \{\par
            document.getElementById("title").innerHTML =\par
                "DOM Manipulation";\par
\par
            document.getElementById("message").innerText =\par
                "Message changed using DOM";\par
        \}\par
\par
        function styleChange() \{\par
            document.getElementById("title").style.color = "pink";\par
\par
            document.getElementById("message").style.backgroundColor =\par
                "lightblue";\par
        \}\par
\par
        function imageChange() \{\par
            document.getElementById("image").src =\par
               "{{\field{\*\fldinst{HYPERLINK https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRXin6kzerDs0yi8Zi2-eJR5VJ1QNMaQGnlgjGeRQ8N4dg3IUdULnbKrWU&s }}{\fldrslt{https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRXin6kzerDs0yi8Zi2-eJR5VJ1QNMaQGnlgjGeRQ8N4dg3IUdULnbKrWU&s\ul0\cf0}}}}\f0\fs22 ";\par
        \}\par
\par
        function linkChange() \{\par
            document.getElementById("link").href =\par
                "{{\field{\*\fldinst{HYPERLINK https://www.youtube.com }}{\fldrslt{https://www.youtube.com\ul0\cf0}}}}\f0\fs22 ";\par
\par
            document.getElementById("link").innerText =\par
                "YouTube";\par
        \}\par
        \par
      \par
        function attributeChange() \{\par
             document.getElementById("image").setAttribute("width", "500");\par
             document.getElementById("image").setAttribute("height", "300");\par
     \}\par
\par
    </script>\par
\par
</body>\par
